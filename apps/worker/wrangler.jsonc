{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "line-split",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "preview_urls": false,
  // LIFF front end (apps/liff build output), served same-origin as the API.
  "assets": {
    "directory": "../liff/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/webhook/", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-split",
      "database_id": "591d11d7-9d54-4b40-80d0-ca01427735ef",
      "migrations_dir": "migrations"
    }
  ],
  // Not secret. Fill in from LINE Developers Console.
  // LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN go in .dev.vars and `wrangler secret put`.
  "vars": {
    "LINE_LOGIN_CHANNEL_ID": "2012045029",
    "LIFF_ID": "2012045029-M7BBPLHN",
    // Feedback reviewers (LINE user ids under this provider), comma-separated.
    "ADMIN_LINE_USER_IDS": "U96cdee0ab0771132936497568dc666e8",
    // "on" pushes each new feedback to the admins; "off" to save push quota.
    "FEEDBACK_PUSH": "on"
  }
}
